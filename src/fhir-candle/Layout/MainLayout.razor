@using FhirCandle.Configuration
@using Microsoft.FluentUI.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@using Microsoft.Extensions.Logging
@using fhir.candle.Ui

@namespace fhir.candle.Layout

@inherits LayoutComponentBase

@inject ProtectedLocalStorage BrowserStore
@inject IFhirStoreManager StoreManager
@inject ISmartAuthManager AuthManager
@inject CandleConfig ServerConfig
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ILogger<MainLayout> Logger
@inject CandleThemeState ThemeState

@implements INavTracker
@implements IDisposable

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header" Class="candle-header">
        <FluentButton Title="Navigation" IconEnd="@(new Icons.Regular.Size24.Navigation())"
                      OnClick="@OpenNavPanel" Appearance="ButtonAppearance.Primary" />
        <FluentSpacer Width="8" />
        <nav class="candle-breadcrumbs" aria-label="Breadcrumb">
            <ol>
                <li><a href="/">@homeTitle</a></li>
                @foreach (NavPageInfoRec item in _crumbs)
                {
                    <li><a href="@item.Link">@item.Display</a></li>
                }
            </ol>
        </nav>
        <FluentSpacer />
        <FluentAnchorButton Href="https://github.com/FHIR/fhir-candle" Target="LinkTarget.Blank"
                            Appearance="ButtonAppearance.Primary" Title="GitHub" IconOnly="true">
            <img src="media/github-mark-white.svg" height="20" width="20" alt="" />
        </FluentAnchorButton>
        <FluentSpacer Width="8" />
        <FluentButton Title="Light/Dark Mode" Appearance="ButtonAppearance.Primary"
                      IconEnd="@(new Icons.Regular.Size20.DarkTheme())" OnClick="@ToggleMode" />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Class="content" Style="width:100%;">
        <CascadingValue Value="@this" IsFixed="true">
            <CascadingValue Value="@BrowserStore" IsFixed=true>
                <CascadingValue Name="@nameof(INavTracker.IsDarkMode)" Value="@IsDarkMode">
                    @Body
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </FluentLayoutItem>
</FluentLayout>


<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    /// <summary>The home title.</summary>
    private string homeTitle = "FHIR Candle";

    /// <summary>Occurs when On Theme Changed.</summary>
    public event EventHandler<EventArgs>? OnThemeChanged;

    /// <summary>Gets the is dark mode.</summary>
    public bool IsDarkMode => ThemeState.IsDarkMode;

    /// <summary>The crumbs.</summary>
    private NavPageInfoRec[] _crumbs = [];

    /// <summary>Links for store.</summary>
    /// <param name="storeName">Name of the store.</param>
    /// <returns>A string.</returns>
    private string LinkForStore(string storeName)
    {
        return $"/store?store={storeName}";
    }

    /// <summary>
    /// Asynchronously opens the navigation panel.
    /// </summary>
    /// <remarks>
    /// This method creates a dialog using the DialogService and shows it.
    /// The dialog displays the navigation menu of the application.
    /// The dialog is configured to not have primary and secondary actions, and the dismiss button is hidden.
    /// The result of the dialog is not used in this method.
    /// </remarks>
    /// <returns>A Task representing the asynchronous operation.</returns>
    private async Task OpenNavPanel()
    {
        // create the dialog
        await DialogService.ShowDrawerAsync<NavMenu>(new DialogOptions()
        {
            Alignment = DialogAlignment.Start,
            Width = "min(20rem, 90vw)",
            Header = { Title = "FHIR Candle", CloseAction = { Visible = false } },
            Footer =
            {
                PrimaryAction = { Visible = false },
                SecondaryAction = { Visible = false },
            },
        });
    }

    /// <summary>Logs an asynchronous.</summary>
    /// <param name="message">The message.</param>
    /// <returns>An asynchronous result.</returns>
    public async Task JsLogAsync(string message)
    {
        try
        {
            await JS.InvokeVoidAsync("console.log", message);
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "Skipping browser logging because the Blazor circuit disconnected.");
        }
    }

    /// <summary>Js clipboard copy.</summary>
    /// <param name="content">The content.</param>
    /// <returns>An asynchronous result.</returns>
    public async Task JsClipboardCopy(string content)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", content);
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "Skipping clipboard copying because the Blazor circuit disconnected.");
        }
    }

    /// <summary>Toggle mode.</summary>
    private void ToggleMode() => ThemeState.Toggle();

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _wasDark = IsDarkMode;
        ThemeState.Changed += HandleThemeChanged;
    }

    private void HandleThemeChanged(object? sender, CandleThemeChangedEventArgs args)
    {
        if (_wasDark != args.IsDarkMode)
        {
            _wasDark = args.IsDarkMode;
            OnThemeChanged?.Invoke(this, EventArgs.Empty);
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private bool _wasDark;

    /// <inheritdoc />
    public void Dispose() => ThemeState.Changed -= HandleThemeChanged;

    /// <summary>Executes the after render action.</summary>
    /// <param name="firstRender">True to first render.</param>
    /// <returns>An asynchronous result.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // first render of layout should log the version
            await JsLogAsync($"fhir-candle: {GetType()?.Assembly?.GetName()?.Version?.ToString()}");

            try
            {
                // use the RI name if there is one
                if (!string.IsNullOrEmpty(ServerConfig.ReferenceImplementation))
                {
                    homeTitle = $"FHIR Candle ({ServerConfig.ReferenceImplementation})";
                    // _crumbs[0] = new NavBreadcrumb($"Candle ({ServerConfig.ReferenceImplementation})", "#");
                }

                StateHasChanged();
            }
            catch (Exception)
            {
                // ignore
            }
        }

        try
        {
            await JS.InvokeVoidAsync("processCopyable");
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "Skipping copyable element initialization because the Blazor circuit disconnected.");
        }
    }
    
    /// <summary>Notifies the navigation manager about the current location.</summary>
    /// <param name="navTree"></param>
    public void NotifyNav(NavPageInfoRec[] navTree)
    {
        _crumbs = navTree;
        StateHasChanged();
    }
}
