@page "/store/resource-list"
@using Microsoft.FluentUI.AspNetCore.Components
@inject SmartViewerSession Session

<FhirStorePage NamedTenant="@(StoreName ?? string.Empty)" ResourceType="@(ResourceType ?? string.Empty)">
    <FluentLabel Size="LabelSize.Large" Weight="LabelWeight.Semibold">@ResourceType Resources</FluentLabel>
    @{ SmartViewerSession.View view = Session.Display;
       IResourceStore? resources = view.AdminStore?.GetValueOrDefault(ResourceType ?? string.Empty); }
    <FluentDataGrid @key="view" Items="@Filtered(view)" ShowHover="true">
        <TemplateColumn Title="Id" Sortable="true" Filtered="@(_idFilter.Length > 0)">
            <ColumnOptions><input type="search" aria-label="Filter by resource ID" @bind="_idFilter" @bind:event="oninput" /></ColumnOptions>
            <ChildContent>
                <FluentLink Href="@($"/store/resource-viewer?store={Uri.EscapeDataString(StoreName ?? string.Empty)}&type={Uri.EscapeDataString(ResourceType ?? string.Empty)}&id={Uri.EscapeDataString(context.Id)}")">@context.Id</FluentLink>
            </ChildContent>
        </TemplateColumn>
        @if (resources?.ResourcesHaveName == true)
        {
            <PropertyColumn Title="Name" Property="@(r => r.Name)" Sortable="true" IsDefaultSortColumn="true" Filtered="@(_nameFilter.Length > 0)">
                <ColumnOptions><input type="search" aria-label="Filter by name" @bind="_nameFilter" @bind:event="oninput" /></ColumnOptions>
            </PropertyColumn>
        }
        @if (resources?.ResourcesAreConformance == true)
        {
            <PropertyColumn Title="Url" Property="@(r => r.Url)" Sortable="true" Filtered="@(_urlFilter.Length > 0)">
                <ColumnOptions><input type="search" aria-label="Filter by URL" @bind="_urlFilter" @bind:event="oninput" /></ColumnOptions>
            </PropertyColumn>
            <PropertyColumn Title="Description" Property="@(r => r.Description)" Sortable="true" Filtered="@(_descriptionFilter.Length > 0)">
                <ColumnOptions><input type="search" aria-label="Filter by description" @bind="_descriptionFilter" @bind:event="oninput" /></ColumnOptions>
            </PropertyColumn>
        }
        @if (resources?.ResourcesAreIdentifiable == true)
        {
            <PropertyColumn Title="Identifiers" Property="@(r => r.Identifiers)" Sortable="true" Filtered="@(_identifierFilter.Length > 0)">
                <ColumnOptions><input type="search" aria-label="Filter by identifier" @bind="_identifierFilter" @bind:event="oninput" /></ColumnOptions>
            </PropertyColumn>
        }
    </FluentDataGrid>
</FhirStorePage>

@code {
    [SupplyParameterFromQuery(Name = "store")] public string StoreName { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "type")] public string ResourceType { get; set; } = string.Empty;
    private string _idFilter = string.Empty;
    private string _nameFilter = string.Empty;
    private string _urlFilter = string.Empty;
    private string _descriptionFilter = string.Empty;
    private string _identifierFilter = string.Empty;

    private IQueryable<InstanceTableRec> Filtered(SmartViewerSession.View view) => view.Rows.Where(r =>
        Matches(r.Id, _idFilter) && (view.AdminStore is null ||
        (Matches(r.Name, _nameFilter) && Matches(r.Url, _urlFilter) && Matches(r.Description, _descriptionFilter) &&
         Matches(r.Identifiers, _identifierFilter)))).AsQueryable();

    private static bool Matches(string? value, string filter) =>
        string.IsNullOrWhiteSpace(filter) || value?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true;
}
