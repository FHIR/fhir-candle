@page "/store"
@using Microsoft.FluentUI.AspNetCore.Components
@inject SmartViewerSession Session
@implements IDisposable

<PageTitle>FHIR Resources: @Tenant</PageTitle>
<FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
    <FluentText Size="TextSize.Size700">FHIR Resources: @Tenant</FluentText>
    <strong>@(Session.Smart ? SmartViewerSession.SmartLabel : SmartViewerSession.AdminLabel) — Tenant: @Tenant</strong>
    <FluentStack Class="store-actions" Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8" VerticalGap="8" VerticalAlignment="VerticalAlignment.Center">
        @if (FormatChanged.HasDelegate)
        {
            <FluentSelect Value="@Format" ValueChanged="@FormatChanged" TOption="string" TValue="string"
                          Label="Resource format" LabelPosition="LabelPosition.Before">
                <FluentOption Value="@("json")">JSON</FluentOption>
                <FluentOption Value="@("xml")">XML</FluentOption>
            </FluentSelect>
        }
        else if (ChildContent is null && !Session.Smart)
        {
            <FluentSwitch Label="Hide Empty Resources" @bind-Value="_hideEmpty" />
        }
        <FluentButton OnClick="SwitchMode">@(Session.Smart ? SmartViewerSession.AdminLabel : SmartViewerSession.SmartLabel)</FluentButton>
        <FluentButton OnClick="Refresh">Refresh</FluentButton>
        <span id="store-access-warning" tabindex="0" role="img" aria-label="Store access warning" style="display: inline-flex;">
            <FluentIcon Value="@(new Icons.Regular.Size20.Warning())" Color="Color.Warning" />
        </span>
        <FluentTooltip Anchor="store-access-warning" UseTooltipService="false">Unauthenticated UI users have admin access to inspect synthetic store state.</FluentTooltip>
        @if (Session.Smart)
        {
            <label>Issued access token <input type="password" autocomplete="off" @bind="_input" @bind:event="oninput" /></label>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SignIn">Use credential</FluentButton>
        }
    </FluentStack>
    @if (Session.Display.Status is {} status && (int)status >= 400)
    {
        <p role="status">Inspector: @((int)status) @status</p>
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <FluentDataGrid @key="Session.Display" Items="@Types" ShowHover="true">
            <TemplateColumn Title="Resource Name" Sortable="true">
                <FluentLink Href="@ListLink(context.Name)">@context.Name</FluentLink>
            </TemplateColumn>
            @if (!Session.Smart)
            {
                <PropertyColumn Title="Instance Count" Property="@(r => r.Count)" Sortable="true" />
            }
        </FluentDataGrid>
    }
</FluentStack>

@code {
    [CascadingParameter] public INavTracker? NavTracker { get; set; }
    [SupplyParameterFromQuery(Name = "store")] public string? StoreName { get; set; }

    // The list and detail routes reuse this inspector shell.
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? NamedTenant { get; set; }
    [Parameter] public string? ResourceType { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Format { get; set; } = "json";
    [Parameter] public EventCallback<string> FormatChanged { get; set; }

    private string Tenant => NamedTenant ?? StoreName ?? string.Empty;
    private string ListLink(string type) => $"/store/resource-list?store={Uri.EscapeDataString(Tenant)}&type={Uri.EscapeDataString(type)}";
    private IQueryable<SmartViewerSession.ResourceKind> Types => Session.Display.Types
        .Where(r => !_hideEmpty || r.Count is null or > 0).AsQueryable();
    private bool _hideEmpty = true;
    private string _input = string.Empty;
    private SmartViewerSession.Request? _request;
    private IFhirStore? _watch;
    private bool _disposed;

    protected override void OnInitialized() => Session.Expired += SessionExpired;

    protected override async Task OnParametersSetAsync()
    {
        SmartViewerSession.Request request = new(Tenant, ResourceType, Id, Format);
        if (_request == request)
        {
            return;
        }
        _request = request;
        _input = string.Empty;
        Session.SelectTenant(Tenant);
        List<NavPageInfoRec> crumbs = [new() { Display = Tenant, Link = $"/store?store={Uri.EscapeDataString(Tenant)}" }];
        if (ResourceType is not null)
        {
            crumbs.Add(new() { Display = ResourceType, Link = ListLink(ResourceType) });
            if (Id is not null)
            {
                crumbs.Add(new()
                {
                    Display = Id,
                    Link = $"/store/resource-viewer?store={Uri.EscapeDataString(Tenant)}&type={Uri.EscapeDataString(ResourceType)}&id={Uri.EscapeDataString(Id)}",
                });
            }
        }
        NavTracker?.NotifyNav(crumbs.ToArray());
        await Refresh();
    }

    private Task SwitchMode()
    {
        _input = string.Empty;
        Session.SelectMode(!Session.Smart);
        return Refresh();
    }

    private Task SignIn()
    {
        Session.SignIn(_input);
        _input = string.Empty;
        return Refresh();
    }

    private async Task Refresh()
    {
        if (_disposed || _request is null)
        {
            return;
        }
        Watch(null);
        await Session.LoadAsync(_request, SmartViewerSession.LoadAdmin);
        if (!_disposed)
        {
            Watch(Session.Display.AdminStore);
        }
    }

    private void Watch(IFhirStore? store)
    {
        if (_watch is not null)
        {
            _watch.OnInstanceCreated -= StoreChanged;
            _watch.OnInstanceUpdated -= StoreChanged;
            _watch.OnInstanceDeleted -= StoreChanged;
        }
        _watch = store;
        if (store is not null)
        {
            store.OnInstanceCreated += StoreChanged;
            store.OnInstanceUpdated += StoreChanged;
            store.OnInstanceDeleted += StoreChanged;
        }
    }

    private void StoreChanged(object? sender, EventArgs e) => _ = InvokeAsync(async () =>
    {
        if (!_disposed && !Session.Smart && _watch is not null)
        {
            await Refresh();
            StateHasChanged();
        }
    });

    private void SessionExpired() => _ = InvokeAsync(() =>
    {
        if (!_disposed)
        {
            _input = string.Empty;
            StateHasChanged();
        }
    });

    public void Dispose()
    {
        _disposed = true;
        Session.Expired -= SessionExpired;
        Session.CloseView(_request);
        Watch(null);
    }
}
