@page "/store/resource-viewer"
@using FhirCandle.Configuration
@using Microsoft.FluentUI.AspNetCore.Components
@inject CandleConfig ServerConfig
@inject SmartViewerSession Session

<FhirStorePage NamedTenant="@(StoreName ?? string.Empty)" ResourceType="@(ResourceType ?? string.Empty)" Id="@(Id ?? string.Empty)" Format="@_format">
    <FluentSelect @bind-Value="_format" TOption="string" TValue="string" Label="Resource format">
        <FluentOption Value="@("json")">JSON</FluentOption>
        <FluentOption Value="@("xml")">XML</FluentOption>
    </FluentSelect>
    @{ SmartViewerSession.View view = Session.Display; }
    @if (view.AdminStore is IFhirStore store)
    {
        @switch (store.Config.FhirVersion)
        {
            case FhirReleases.FhirSequenceCodes.R4:
                <FhirCandle.Ui.R4.Components.FhirEditorLinks BaseUrl="@store.Config.BaseUrl" ResourceType="@ResourceType" Id="@Id" FhirPathLabUrl="@ServerConfig.FhirPathLabUrl" />
                break;
            case FhirReleases.FhirSequenceCodes.R4B:
                <FhirCandle.Ui.R4B.Components.FhirEditorLinks BaseUrl="@store.Config.BaseUrl" ResourceType="@ResourceType" Id="@Id" FhirPathLabUrl="@ServerConfig.FhirPathLabUrl" />
                break;
            case FhirReleases.FhirSequenceCodes.R5:
                <FhirCandle.Ui.R5.Components.FhirEditorLinks BaseUrl="@store.Config.BaseUrl" ResourceType="@ResourceType" Id="@Id" FhirPathLabUrl="@ServerConfig.FhirPathLabUrl" />
                break;
        }
        <FhirCandle.Ui.Common.Components.FhirEditor Language="@_format" EditorContent="@view.Body" DarkMode="@(NavTracker?.IsDarkMode ?? true)" />
    }
    else if (!string.IsNullOrEmpty(view.Body))
    {
        <pre>@view.Body</pre>
    }
</FhirStorePage>

@code {
    [CascadingParameter] public INavTracker? NavTracker { get; set; }
    [SupplyParameterFromQuery(Name = "store")] public string StoreName { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "type")] public string ResourceType { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "id")] public string Id { get; set; } = string.Empty;
    private string _format = "json";
}
