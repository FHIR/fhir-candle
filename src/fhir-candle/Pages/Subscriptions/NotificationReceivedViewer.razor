@using Microsoft.FluentUI.AspNetCore.Components;

@page "/subscriptions/notification-received-viewer"

@inject NavigationManager NavigationManager
@inject IFhirStoreManager StoreManager

@implements IDisposable

<PageTitle>Received Subscription Events</PageTitle>

@{
    IReadOnlyList<ParsedSubscriptionStatus>? notifications = _store?.ReceivedNotifications.GetValueOrDefault(SubscriptionRef);
}
@if (notifications is null || notifications.Count == 0)
{
    <FluentLabel>No events received for this Subscription.</FluentLabel>
}
else
{
    <FluentGrid Spacing="4">
        @foreach (ParsedSubscriptionStatus status in notifications)
        {
            <FluentGridItem Style="min-width: var(--field-container-min-width);">
                <FluentCard>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                        <FluentTextInput Label="Subscription" ReadOnly="true" Value="@status.SubscriptionReference"/>
                        <FluentTextInput Label="Topic" ReadOnly="true" Value="@status.SubscriptionTopicCanonical"/>
                        <FluentTextInput Label="Local Bundle" ReadOnly="true" Value="@("Bundle/" + status.BundleId)"/>
                        <FluentTextInput Label="Received" ReadOnly="true" Value="@status.ProcessedDateTime.ToString("o")"/>
                        <FluentTextInput Label="Type" ReadOnly="true" Value="@status.NotificationType?.ToString()"/>

                        <FluentLabel>Bundle</FluentLabel>
                        <FluentLink Href="@($"/store/resource-viewer?store={StoreName}&type=Bundle&id={status.BundleId}")">Bundle/@status.BundleId</FluentLink>

                        @if (status.NotificationEvents.Any())
                        {
                            @foreach (ParsedSubscriptionStatus.ParsedNotificationEvent ne in status.NotificationEvents)
                            {
                                <FluentTextInput Label="Event Number" ReadOnly="true" Value="@ne.EventNumber?.ToString()"/>
                                <FluentTextInput Label="Timestamp" ReadOnly="true" Value="@ne.Timestamp?.ToLocalTime().ToString("O")"/>
                                <FluentTextInput Label="Focus Reference" ReadOnly="true" Value="@ne.FocusReference"/>
                                <FluentTextInput Label="Additional Context" ReadOnly="true" Value="@string.Join(", ", ne.AdditionalContextReferences ?? Array.Empty<string>())"/>
                            }
                        }

                        @if (status.Errors.Any())
                        {
                            <FluentTextInput Label="Error" ReadOnly="true" Value="@status.Errors.First()"/>
                        }
                    </FluentStack>
                </FluentCard>
            </FluentGridItem>
        }
    </FluentGrid>
}

@code {
    /// <summary>Gets or sets the navigation tracker.</summary>
    [CascadingParameter]
    public INavTracker? NavTracker { get; set; } = null;

    private NavPageInfoRec[] _navPages => new NavPageInfoRec[]
    {
        new() { Display = StoreName, Link = "/store?store=" + StoreName },
        new() { Display = "Received Subscription Events", Link = $"/subscriptions/notifications-received?store={StoreName}" },
        new() { Display = SubscriptionRef, Link = $"/subscriptions/notification-received-viewer?store={StoreName}&ref={SubscriptionRef}" },
    };

    /// <summary>Gets or sets the package name.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "store")]
    public string StoreName { get; set; } = "";

    [Parameter]
    [SupplyParameterFromQuery(Name = "ref")]
    public string SubscriptionRef { get; set; } = "";

    private IFhirStore _store = null!;

    /// <summary>Executes the initialized asynchronous action.</summary>
    /// <returns>An asynchronous result.</returns>
    protected override void OnInitialized()
    {
        base.OnInitialized();

        if ((!string.IsNullOrEmpty(StoreName)) &&
            (StoreManager.TryGetValue(StoreName, out _store!)))
        {
            _store.OnReceivedSubscriptionEvent += Store_OnReceivedSubscriptionEvent;
            _store.OnReceivedSubscriptionChanged += Store_OnReceivedSubscriptionEvent;
        }

        // notify of store root in case user clicked here directly
        NavTracker?.NotifyNav(_navPages);
    }

    /// <summary>Handles the location changed.</summary>
    /// <param name="sender">The sender.</param>
    /// <param name="e">     Location changed event information.</param>
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (e.Location.ToLowerInvariant().Contains("/subscriptions/notification-received-viewer", StringComparison.Ordinal))
        {
            if (_store is not null)
            {
                _store.OnReceivedSubscriptionEvent -= Store_OnReceivedSubscriptionEvent;
                _store.OnReceivedSubscriptionChanged -= Store_OnReceivedSubscriptionEvent;
            }

            if ((!string.IsNullOrEmpty(StoreName)) &&
                (StoreManager.TryGetValue(StoreName, out _store!)))
            {
                _store.OnReceivedSubscriptionEvent += Store_OnReceivedSubscriptionEvent;
                _store.OnReceivedSubscriptionChanged += Store_OnReceivedSubscriptionEvent;
            }

            // notify of store root in case user clicked here directly
            NavTracker?.NotifyNav(_navPages);
        }
    }

    /// <summary>Event handler. Called by Store for on subscription events.</summary>
    /// <param name="sender">The sender.</param>
    /// <param name="e">     Subscription event information.</param>
    private void Store_OnReceivedSubscriptionEvent(object? sender, object e)
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Performs application-defined tasks associated with freeing, releasing, or resetting unmanaged
    /// resources.
    /// </summary>
    public void Dispose()
    {
        if (_store is not null)
        {
            _store.OnReceivedSubscriptionEvent -= Store_OnReceivedSubscriptionEvent;
            _store.OnReceivedSubscriptionChanged -= Store_OnReceivedSubscriptionEvent;
        }
    }

}
