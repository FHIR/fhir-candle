@using Microsoft.FluentUI.AspNetCore.Components;
@using Hl7.Fhir.Utility;

@inject IHttpContextAccessor HttpContextAccessor

<FluentAccordion>
    <FluentAccordionItem Header="Patient Selection" Expanded="true">
         <FluentAutocomplete Id="patient-selector"
                @ref="PatientSelector"
                TOption="Hl7.Fhir.Model.Patient"
                TValue="string"
                Width="100%"
                Placeholder="search"
                MaximumSelectedOptions="1"
                Multiple="false"
                OnOptionsSearch="@OnPatientSearch"
                OptionText="@(item => displayFor(item!))"
                OptionValue="@(item => item?.Id)"
                @bind-SelectedItems="@SelectedPatients">
            <LabelTemplate>
                Select a patient
                <FluentIcon Value="@(new Icons.Regular.Size20.Person())" Style="margin: 0 4px;" />
            </LabelTemplate>
            <SelectedOptionTemplate>
                <FluentStack Orientation="Orientation.Horizontal" Style="min-height: 26px; background: var(--candle-hover)">
                    <FluentPresenceBadge Status="PresenceStatus.Available">
                        <AnchorContent>
                            <FluentAvatar Name="@(displayFor(context))" Size="AvatarSize.Size24" Initials="@(getInitials(context.Name))" />
                        </AnchorContent>
                    </FluentPresenceBadge>
                    <FluentText>@displayFor(context)</FluentText>
                    <FluentButton Title="Remove" IconEnd="@(new Icons.Regular.Size20.Dismiss())"
                                  OnClick="@(() => SelectedPatients = [])" />
                </FluentStack>
            </SelectedOptionTemplate>
            <OptionTemplate>
                <FluentStack Orientation="Orientation.Horizontal" Style="min-height: 40px;">
                    <FluentPresenceBadge Status="PresenceStatus.Available">
                        <AnchorContent>
                            <FluentAvatar Size="AvatarSize.Size32" Initials="@(getInitials(context.Name))" Name="@(displayFor(context))" />
                        </AnchorContent>
                    </FluentPresenceBadge>
                    <FluentText>@displayFor(context)</FluentText>
                </FluentStack>
            </OptionTemplate>
            <MaximumSelectedOptionsMessage>
                Only one patient can be selected.
            </MaximumSelectedOptionsMessage>
            <FooterContent>
                @if (!context.Items.Any())
                {
                    <FluentLabel Style="font-size: 11px; text-align: center; width: 200px;">
                        No results found
                    </FluentLabel>
                }
            </FooterContent>
        </FluentAutocomplete>
    </FluentAccordionItem>

    <br />

    <FluentAccordionItem Header="Subscription Management" Expanded="true">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            <FluentLabel>
                If you have an existing Subscription, please use it. However, please do not modify subscriptions
                that other people are using for testing. In order to facilitate that, please enter a user tag
                that can be used to disambiguate subscriptions.

                Note that this does not apply to resources relating to your subscriptions (e.g., other users
                can still create an encounter that will trigger your subscription).
            </FluentLabel>

            <FluentTextInput @bind-Value="UserTag" Label="User Tag" />
            <FluentAutocomplete Id="subscription-selector"
                    Label="Select Subscription"
                    TOption="ParsedSubscription"
                    TValue="string"
                    Width="100%"
                    Placeholder="Select a subscription"
                    MaximumSelectedOptions="1"
                    Multiple="false"
                    OnOptionsSearch="@OnSubscriptionSearch"
                    OptionText="@(item => displayFor(item!))"
                    OptionValue="@(item => item?.Id)"
                    @bind-SelectedItems="@SelectedSubscriptions">
                <OptionTemplate>
                    <div style="min-height: 40px;">@displayFor(context)</div>
                </OptionTemplate>
                <MaximumSelectedOptionsMessage>
                    Only one subscription can be selected.
                </MaximumSelectedOptionsMessage>
                <FooterContent>
                    @if (!context.Items.Any())
                    {
                        <FluentLabel Style="font-size: 11px; text-align: center; width: 200px;">
                            No results found
                        </FluentLabel>
                    }
                </FooterContent>
            </FluentAutocomplete>

            <br />

            <FluentCard Width="600px">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                    @if (SelectedSubscriptions.Any())
                    {
                        <FluentLabel Size="LabelSize.Large" Weight="LabelWeight.Semibold">Edit Subscription</FluentLabel>
                    }
                    else
                    {
                        <FluentLabel Size="LabelSize.Large" Weight="LabelWeight.Semibold">Create Subscription</FluentLabel>
                    }

                    <FluentTextInput @bind-Value="_editingSubscription.Reason" Label="Reason (Description)" />

                    <FluentSelect Label="Status" @bind-Value="_editingSubscription.CurrentStatus" TOption="string" TValue="string">
                        <FluentOption Value="@("requested")">Requested</FluentOption>
                        <FluentOption Value="@("active")">Active</FluentOption>
                        <FluentOption Value="@("error")">Error</FluentOption>
                        <FluentOption Value="@("off")">Off</FluentOption>
                        <FluentOption Value="@("entered-in-error")">Entered In Error</FluentOption>
                    </FluentSelect>

                    <FluentSelect Label="Channel Type" @bind-Value="_editingSubscription.ChannelCode" TOption="string" TValue="string">
                        <FluentOption Disabled="true" Value="@("email")">Email</FluentOption>
                        <FluentOption Disabled="true" Value="@("message")">FHIR Message</FluentOption>
                        <FluentOption Value="@("rest-hook")">REST Hook (http/s POST)</FluentOption>
                        <FluentOption Disabled="true" Value="@("websocket")">Websocket</FluentOption>
                    </FluentSelect>

                    <FluentTextInput @bind-Value="_editingSubscription.Endpoint" Label="Endpoint" />
                    <FluentNumberInput @bind-Value="_editingSubscription.HeartbeatSeconds" Label="Heartbeat frequency (seconds)" />
                    <FluentTextInput @bind-Value="Expiration" Label="End (expiration)" ReadOnly="true" />

                    <FluentLabel>
                        MIME Type to use for notifications:
                    </FluentLabel>

                    <FluentSelect Label="Content Type" @bind-Value="_editingSubscription.ContentType" TOption="string" TValue="string">
                        <FluentOption Value="@("application/fhir+json")">FHIR JSON</FluentOption>
                        <FluentOption Value="@("application/fhir+xml")">FHIR XML</FluentOption>
                    </FluentSelect>

                    <FluentLabel>
                        Amount of data to include in notifications:
                    </FluentLabel>

                    <FluentSelect Label="Content Level" @bind-Value="_editingSubscription.ContentLevel" TOption="string" TValue="string">
                        <FluentOption Value="@("empty")">Empty</FluentOption>
                        <FluentOption Value="@("id-only")">IDs Only</FluentOption>
                        <FluentOption Value="@("full-resource")">Full Resources</FluentOption>
                    </FluentSelect>
                </FluentStack>
            </FluentCard>


        </FluentStack>
    </FluentAccordionItem>

    <br />

    <FluentAccordionItem Header="Status Panel" Expanded="true">
        <FluentLabel>
            Status Panel
            <br />
        </FluentLabel>
    </FluentAccordionItem>
</FluentAccordion>
