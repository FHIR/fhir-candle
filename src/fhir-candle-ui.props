<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- Solution-wide properties for NuGet packaging -->

  <PropertyGroup>
    <CandleFluentUIVersion>5.1.0</CandleFluentUIVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="$(CandleFluentUIVersion)" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Emoji" Version="$(CandleFluentUIVersion)" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="$(CandleFluentUIVersion)" />
    <PackageReference Include="BlazorMonaco" Version="3.5.0" IncludeAssets="all" />
  </ItemGroup>

  <!--
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  -->
</Project>
